{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/mobile-development/layout,_N_T_/mobile-development/page,_N_T_/mobile-development"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/mobile-development/__PAGE__",
    "/mobile-development",
    "/_index"
  ]
}